{
  "manifestVersion": 5,
  "id": "com.leoda.pilha.premiere",
  "name": "FastBind",
  "version": "0.3.1",
  "main": "index.html",
  "host": { "app": "premierepro", "minVersion": "26.3.0" },
  "entrypoints": [
    {
      "type": "panel",
      "id": "pilhaPanel",
      "label": { "default": "FastBind" },
      "minimumSize": { "width": 230, "height": 180 },
      "preferredDockedSize": { "width": 450, "height": 600 },
      "preferredFloatingSize": { "width": 620, "height": 700 }
    }
  ],
  "requiredPermissions": { "localFileSystem": "fullAccess" }
}
